rules_version = '2';

// Règles de sécurité de la base WouStore.
// Par défaut, tout est fermé : on n'ouvre que ce qui est nécessaire.
service cloud.firestore {
  match /databases/{database}/documents {

    // Les administrateurs de WouStore (toi) : un document par identifiant.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // Chacun peut seulement vérifier s'il est lui-même administrateur.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // ajouté à la main dans la console
    }

    // Les avis : reviews/{appli}/items/{utilisateur}
    match /reviews/{appId}/items/{uid} {
      // Tout le monde peut lire les avis, même sans compte.
      allow read: if true;

      // On ne peut écrire QUE son propre avis, avec une note de 1 à 5
      // et un commentaire de 500 caractères au plus.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'version', 'updatedAt', 'createdAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt == request.time;

      // Supprimer : l'auteur de l'avis, ou un administrateur.
      allow delete: if request.auth != null
        && (request.auth.uid == uid || isAdmin());

      // Le développeur de l'appli peut répondre aux avis (seulement les champs de réponse).
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'replyAt'])
        && request.resource.data.reply is string
        && request.resource.data.reply.size() <= 500;
    }

    // Signalements : un par personne et par appli ; seul l'administrateur les lit.
    match /reports/{appId}/items/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['reason', 'createdAt'])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;
      allow read, delete: if isAdmin();
    }

    // Applis retirées (signalements) : tout le monde le sait, seul l'administrateur décide.
    match /moderation/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Espace développeur ----------

    // La fiche d'un développeur : lui-même ou l'administrateur.
    match /developers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // S'inscrire (ou se réinscrire après un refus) : toujours « en attente ».
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['fullName', 'phone', 'email', 'status', 'createdAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      allow update: if isAdmin()
        || (request.auth != null && request.auth.uid == uid
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending');
    }

    // La photo de la pièce d'identité : rangée à part, jamais publique.
    match /developer_ids/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000;
      allow delete: if isAdmin();
    }

    // Les applis proposées : seul un développeur validé peut en proposer.
    match /submissions/{id} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    // File d'attente de l'analyse anti-virus : seulement le dépôt GitHub (lu par le robot).
    match /submission_queue/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['github', 'asset', 'createdAt'])
        && request.resource.data.github is string
        && request.resource.data.github.size() <= 120
        && get(/databases/$(database)/documents/developers/$(request.auth.uid)).data.status == 'approved';
      allow delete: if isAdmin();
    }

    // Les applis publiées : tout le monde les lit, seul l'administrateur les écrit.
    match /apps/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
